{
  "name": "atmende-schildkroete",
  "version": "1.0.0",
  "description": "Tika die atmende Schildkröte – Interaktiver Atembegleiter, Insel-Geschichten, Meeresmuster & Biofeedback-Respirations-Engine",
  "type": "module",
  "author": "Felix Zeller",
  "license": "MIT",
  "homepage": "https://github.com/felixinberlin/atmende-schildkroete",
  "repository": {
    "type": "git",
    "url": "https://github.com/felixinberlin/atmende-schildkroete.git"
  },
  "keywords": [
    "breathing-exercises",
    "mindfulness",
    "pranayama",
    "svg-animation",
    "audio-synthesis",
    "biofeedback",
    "breath-detection",
    "respiratory-regulation",
    "react",
    "typescript"
  ],
  "main": "dist/turtle_breathing_engine.js",
  "module": "dist/turtle_breathing_engine.mjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema": "node scripts/generate-schema.ts",
    "build:engine": "vite build -c vite.lib.config.ts",
    "build:all": "npm run build && npm run build:engine"
  },
  "dependencies": {
    "@xyflow/react": "^12.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
